generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Auth (NextAuth) ──

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  emailVerified  DateTime?
  password       String?
  image          String?
  role           Role     @default(VIEWER)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  sessions Session[]
  accounts Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String @id @default(cuid())
  userId            String @map("user_id")
  type              String
  provider          String
  providerAccountId String @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ── Organization ──

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique
  logo String?

  users     User[]
  devices   Device[]
  geofences Geofence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

// ── Device / GPS Tracker ──

model Device {
  id             String       @id @default(cuid())
  name           String
  imei           String       @unique
  provider       GpsProvider
  providerConfig Json?
  vehiclePlate   String?
  vehicleType    VehicleType?
  status         DeviceStatus @default(OFFLINE)
  lastSeenAt     DateTime?
  lastLatitude   Float?
  lastLongitude  Float?
  lastSpeed      Float?
  lastHeading    Float?
  lastIgnition   Boolean?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  locations      Location[]
  alerts         Alert[]
  trips          Trip[]
  geofenceDevices GeofenceDevice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("devices")
}

// ── Location History ──

model Location {
  id         String   @id @default(cuid())
  deviceId   String   @map("device_id")
  latitude   Float
  longitude  Float
  altitude   Float?
  speed      Float?
  heading    Float?
  ignition   Boolean?
  satellites Int?
  accuracy   Float?
  fuelLevel  Float?
  odometer   Float?
  recordedAt DateTime
  receivedAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt])
  @@map("locations")
}

// ── Geofence ──

model Geofence {
  id             String       @id @default(cuid())
  name           String
  description    String?
  type           GeofenceType
  centerLat      Float?
  centerLng      Float?
  radius         Float?
  polygon        Json?
  color          String       @default("#3b82f6")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  geofenceDevices GeofenceDevice[]
  alerts          Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("geofences")
}

model GeofenceDevice {
  id         String @id @default(cuid())
  geofenceId String @map("geofence_id")
  deviceId   String @map("device_id")

  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([geofenceId, deviceId])
  @@map("geofence_devices")
}

// ── Trip ──

model Trip {
  id              String    @id @default(cuid())
  deviceId        String    @map("device_id")
  startAddress    String?
  endAddress      String?
  startOdometer   Float?
  endOdometer     Float?
  distance        Float?
  maxSpeed        Float?
  averageSpeed    Float?
  duration        Int?
  startedAt       DateTime
  endedAt         DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, startedAt])
  @@map("trips")
}

// ── Alert ──

model Alert {
  id          String        @id @default(cuid())
  deviceId    String        @map("device_id")
  geofenceId  String?       @map("geofence_id")
  type        AlertType
  severity    AlertSeverity @default(INFO)
  message     String
  latitude    Float?
  longitude   Float?
  isRead      Boolean       @default(false)
  triggeredAt DateTime      @default(now())

  device   Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  geofence Geofence? @relation(fields: [geofenceId], references: [id])

  @@index([deviceId, triggeredAt])
  @@map("alerts")
}

// ── Enums ──

enum Role {
  ADMIN
  MANAGER
  VIEWER
}

enum GpsProvider {
  TELTONIKA
  QUECLINK
  CONCOX
  MOCK
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  IDLE
}

enum VehicleType {
  CAR
  TRUCK
  MOTORCYCLE
  VAN
  BUS
  OTHER
}

enum GeofenceType {
  CIRCLE
  POLYGON
}

enum AlertType {
  SPEEDING
  GEOFENCE_ENTER
  GEOFENCE_EXIT
  SOS
  IGNITION_ON
  IGNITION_OFF
  LOW_BATTERY
  DEVICE_OFFLINE
  IDLE_TOO_LONG
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}
